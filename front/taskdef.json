{
  "family": "front_task_definition",
  "networkMode": "bridge",
  "cpu": "256",
  "memory": "512",
  
  "executionRoleArn": "arn:aws:iam::650251731474:role/service-role/ecsTaskExecutionRole",
      
  "containerDefinitions": [
    {
      "name": "front",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ]
    }
  ]
}

