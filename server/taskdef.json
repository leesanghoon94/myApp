{
  "family": "server_task_definition",
  "networkMode": "bridge",
  "cpu": 256,
  "memory": 512,
  
  "executionRoleArn": "arn:aws:iam::650251731474:role/service-role/ecsTaskExecutionRole",
      
  "containerDefinitions": [
    {
      "name": "server",
      "image": "<IMAGE2_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3333,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ]
    }
  ]
}

